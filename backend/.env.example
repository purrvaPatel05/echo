# Backend settings. Copy to backend/.env (git-ignored) and run the backend from backend/.
# NEVER commit real values: .env is git-ignored, this file holds placeholders only.
# Every name below is a field of app/config.py (checked by tests/test_deploy_config.py).
# Legend:  [required in production]   [optional]   [local only]
#
# The frontend has one build-time variable, set on the hosting platform (not in this file):
#   VITE_USE_MOCK=false    <- MUST be set when building the site, or it ships the in-browser mock.

# --- Environment -------------------------------------------------------------------------------
# [required in production] "production" turns on strict startup checks: refuses AUTH_MODE=dev, SQLite or
# default database credentials, and a "*" CORS origin; also hides /docs. Default: development.
ENVIRONMENT=development

# --- Database ----------------------------------------------------------------------------------
# [required in production] PostgreSQL over the asyncpg driver (SQLite is for local use only):
#   postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
# Managed databases need TLS: use "?ssl=require" (asyncpg does NOT understand psycopg's "sslmode=").
# Migrations use this same URL:  uv run alembic upgrade head
# Local options: Postgres from docker-compose.yml (default), or SQLite with no Docker:
#   DATABASE_URL=sqlite+aiosqlite:///./echo.db
DATABASE_URL=postgresql+asyncpg://echo:echo@localhost:5432/echo

# --- Authentication ----------------------------------------------------------------------------
# auth0 (default): real logins. Requests must carry "Authorization: Bearer <Auth0 access token>".
# dev:  local only. Trusts an X-Dev-Physician header. REFUSED when ENVIRONMENT=production.
# demo: temporary public-demo mode for a frontend that cannot log in. Only /api/echo/* works, and
#       only with the header "X-Demo-Access: <DEMO_ACCESS_TOKEN>", which a reverse proxy must add.
AUTH_MODE=dev

# [local only] AUTH_MODE=dev: act as this physician when no X-Dev-Physician header is sent.
DEV_DEFAULT_PHYSICIAN=doc_001

# [required for AUTH_MODE=auth0] Auth0 tenant, API identifier, and the claim namespace.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://api.echo.example
# AUTH_CLAIM_NAMESPACE=https://echo

# session: demo physicians sign in on the login page and get a signed token (see below). Each account has its own
#       referrals and conversations. Demo-grade; needs the login screen, so it works with the real frontend.
# [required for AUTH_MODE=demo] a long random secret (>= 24 chars), e.g. `openssl rand -hex 32`.
# The same value goes in the reverse proxy, which adds it to every /api request.
# DEMO_ACCESS_TOKEN=
# Everyone in demo mode acts as this seeded physician.
# DEMO_PHYSICIAN_ID=doc_001

# [required for AUTH_MODE=session] signs the session tokens: 32+ random characters, e.g. `openssl rand -hex 32`.
# SESSION_SECRET=
# How long a sign-in lasts.
SESSION_HOURS=12
# [AUTH_MODE=session] the shared password of the demo accounts (8+ characters). Their emails are like
# elena.ruiz@riverside.example (first.last@practice.example).
# DEMO_PASSWORD=
# [AUTH_MODE=session] also show a one-click "Demo accounts" list (no password). Anyone who reaches the login page
# can then enter as any demo physician, so use it only when the whole site is a demo.
DEMO_ACCOUNT_LOGIN=false

# --- Browser access ----------------------------------------------------------------------------
# JSON list of origins allowed to call the API cross-origin. Not needed when the site and /api
# share one origin (the frontend calls a relative /api). Never "*" in production.
CORS_ORIGINS=["http://localhost:5173"]

# --- Background jobs and Redis -----------------------------------------------------------------
# inline: matching runs inside the API process (no Redis). celery: separate worker, needs Redis.
# The /api/echo analysis always runs inline. Redis is otherwise only for live consult delivery.
JOB_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Demo colleague (consult chat) -----------------------------------------------------------
# [demo only] true: a few seconds after a chat message is sent, the colleague "answers" with a canned reply
# that is always labelled "Demo reply". Refused with AUTH_MODE=auth0 (it would write messages no person sent).
SIMULATE_COLLEAGUE_REPLIES=false
SIMULATED_REPLY_DELAY_SECONDS=3

# --- Optional integrations. Leave commented out to run without them ----------------------------
# Claude reads the case notes and judges specialist fit. Without it a keyword fallback is used
# (less accurate). Each new referral makes two Claude calls, so a public site spends credits.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_TIMEOUT_SECONDS=60
# CLAUDE_SERVER_FALLBACK=true
# Real driving distances. NOT needed: without it straight-line distance is used.
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_TIMEOUT_SECONDS=5
