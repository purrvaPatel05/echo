# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored: never commit it.
# Generate secrets with:  openssl rand -hex 32

# --- Address ------------------------------------------------------------------------------------------------
# Now (no domain yet): your server's IP with dashes + .sslip.io gives you a real hostname and free HTTPS,
# e.g. IP 203.0.113.7 -> 203-0-113-7.sslip.io
# Later: your own domain, e.g. echo.example.com (point its DNS A record at the server first).
# ":80" = plain HTTP on the IP (works, but passwords and tokens are then sent unencrypted).
SITE_ADDRESS=203-0-113-7.sslip.io

# --- Database (its password is also used to build DATABASE_URL in docker-compose.yml) -----------------------
POSTGRES_PASSWORD=change-me

# --- Sign-in (demo mode: each demo doctor has their own data) -----------------------------------------------
AUTH_MODE=session
SESSION_SECRET=change-me-32-characters-or-more
DEMO_PASSWORD=change-me-8-characters-or-more
# true = the login page also has one-click "demo doctor" buttons that need no password. Anyone who opens
# the site can then enter as any demo doctor, so only leave it true for a public demo.
DEMO_ACCOUNT_LOGIN=true

# --- Case reading -------------------------------------------------------------------------------------------
# Without a key a simple keyword fallback is used (results are less accurate). Claude credits are spent per referral.
ANTHROPIC_API_KEY=

# --- Demo behaviour -----------------------------------------------------------------------------------------
# A colleague "answers" chat messages a few seconds later with a canned reply labelled "Demo reply".
SIMULATE_COLLEAGUE_REPLIES=true
SIMULATED_REPLY_DELAY_SECONDS=3
